<!-- Hero Section -->
<section id="cc-hero-section" class="hero relative min-h-[50dvh] overflow-hidden z-0"
	style="background-color: #280031;">
	<div class="hero-overlay"></div>
	<div class="relative hero-content w-full max-w-3xl text-neutral-content text-center z-10">
		<div class="w-full z-10">
			<h1 class="mb-5 text-banner-text text-3xl md:text-5xl font-ott font-bold">
				{{dc 'hc_-_how_can_we_help'}}
			</h1>
			<p>
				<span class="text-green-400">
					85%
				</span>
				of users resolve issues using Codee
			</p>
			<button id="ask-codee" class="bg-[#E8F953] text-brand-text btn rounded-full px-4 py-1 mt-4">
				Ask Codee
			</button>
		</div>

		<img src="{{asset 'codee.webp'}}" alt="" aria-hidden="true"
			class="pointer-events-none select-none absolute -bottom-24 md:-bottom-16 right-0 w-42 h-42 z-5">
	</div>

	<!-- Torn-paper edge: blends the hero into the page background -->
	<img src="{{asset 'tear.webp'}}" alt="" aria-hidden="true"
		class="pointer-events-none select-none absolute inset-x-0 bottom-0 w-full h-16 z-1">
</section>

{{#if settings.show_popular_section}}
<section id="popular-resource-section" class="hidden max-w-5xl max-md:w-full lg:w-full mx-auto px-4 md:px-10 py-12">
	<div class="flex flex-col items-center">
		{{dc 'hc_-_popular_resources'}}
		{{#if (compare promoted_articles.length ">" 0)}}
		<ul class="w-full list mt-8 gap-4">
			{{#each promoted_articles}}
			<li id="article-{{id}}">
				<a href="{{url}}"
					class="btn btn-md h-[50px] flex items-center justify-between border-2 border-brand bg-brand/80 hover:bg-brand transition-colors rounded-lg text-cta-text text-start text-sm line-clamp-1 leading-4 shadow-sm">
					{{title}}
					<i class="ph ph-arrow-right"></i>
				</a>
			</li>
			{{/each}}
		</ul>
		{{/if}}
	</div>
</section>
{{/if}}

<section id="self-service-articles-section" class="max-w-5xl max-md:w-full lg:w-full mx-auto px-4 md:px-10 py-12">
	<div class="flex flex-col items-center">
		{{dc 'hc_-_self_service_support'}}
		<div class="w-full mt-8 space-y-8 flex justify-center">
			{{search
			instant=true
			class="input max-md:w-full md:w-1/2 focus-within:outline-brand !text-black rounded-lg h-12 py-1 mx-auto"
			}}
		</div>

		<div class="w-full mt-8 grid grid-cols-1 md:grid-cols-6 gap-5">
			{{#each categories}}
			{{#each sections}}
			<a href="{{url}}" class="{{#if (compare @index " <" 3)}}md:col-span-2{{else}}md:col-span-3{{/if}} rounded-2xl
				border border-brand/30 bg-accordion-bg p-6 text-center shadow-sm transition hover:border-brand hover:shadow-md">
				<h3 class="text-lg font-semibold text-accordion-text">{{name}}</h3>
				{{#if description}}
				<p class="mt-2 text-sm text-accordion-text font-light">{{description}}</p>
				{{/if}}
			</a>
			{{/each}}
			{{/each}}
		</div>
	</div>
</section>

<section id="need-assistance-section" class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 py-12">
	<div class="flex flex-col items-center gap-3">
		{{dc 'hc_-_need_assistance'}}
		<a href="{{page_path 'new_request'}}"
			class="btn bg-transparent hover:bg-brand border-brand shadow-none text-brand hover:text-white rounded-full mt-4">
			{{dc 'hc_standard_-_submit_a_request_button'}}
		</a>
	</div>
</section>

<div id="codee-container"></div>

<script defer type="text/javascript" src="https://prod-au-druid-cdn.azureedge.net/v2/druid_webchat_v2.js"></script>
<script data-druid-language="ms" type="text/javascript">
	document.addEventListener("DOMContentLoaded", function (event) {
		DruidWebchat_v2.init({
			botId: "db017925-4ab2-48fa-522b-08ddf7367496",
			baseUrl: "https://druidapi.au.druidplatform.com",
			queryParams: `SiteLang=ms&Country=Malaysia`,
			UI: {
				containerElement: document.getElementById('ask-codee'),
				height: '80dvh',
				closeButtonEnabled: true,
				showCloseButton: true,
			}
		});
	});
</script>