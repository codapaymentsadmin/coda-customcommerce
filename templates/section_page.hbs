<div class="gtranslate_wrapper"></div>
<section id="cc-hero-section" class="hero min-h-[30dvh] sm:min-h-[40dvh]" data-hero-section>
  <div class="hero-overlay"></div>
  <div class="hero-content w-full max-w-3xl text-neutral-content text-center">
    <div class="w-full">
      <div id="category-logo" class="mb-4" style="display: none;">
        <img id="category-logo-img" src="" alt="Game Logo" class="mx-auto max-h-20">
      </div>
      <h1 class="mb-5 text-banner-text font-bold">
        {{section.name}}
      </h1>
      {{#if section.description}}
      <p class="text-banner-text mb-6">{{section.description}}</p>
      {{/if}}
    </div>
  </div>
</section>

<section id="main-content" class="flex-1 min-h-[50dvh] py-12 bg-white">
  <div class="flex flex-col max-w-5xl mx-auto px-4 xl:px-0">
    <!-- Breadcrumbs using Zendesk helper -->
    <nav class="custom-breadcrumbs text-sm mb-6">
      {{breadcrumbs}}
    </nav>


    <div class="w-full flex flex-col gap-4 mt-8">
      {{#if section.sections}}
      <div class="w-full mb-4 border-b border-gray-300 pb-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each section.sections}}
          <a href="{{url}}"
            class="btn btn-md h-[60px] flex items-center justify-between bg-cta text-cta-text hover:bg-cta/90 transition-colors rounded-lg text-start text-sm font-medium shadow-md subsection-btn">
            <div class="flex items-center gap-3">
              <i class="ph ph-folder text-lg"></i>
              <span class="line-clamp-1">{{name}}</span>
            </div>
            <i class="ph ph-arrow-right"></i>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if section.articles}}
      <div class="w-full">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each section.articles}}
          <a id="article-{{id}}" href="{{url}}"
            class="btn btn-md h-[50px] flex items-center justify-between border-2 border-cta bg-white text-cta hover:bg-cta !hover:text-white transition-colors rounded-lg text-start text-sm line-clamp-1 leading-4 shadow-sm article-btn">
            <span class="w-full line-clamp-1">
              {{title}}
            </span>
            <i class="ph ph-arrow-right"></i>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#unless section.sections}}{{#unless section.articles}}
      <div class="text-center py-8">
        <p class="text-main-text">No content available in this section yet.</p>
      </div>
      {{/unless}}{{/unless}}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const breadcrumbsNav = document.querySelector('.custom-breadcrumbs');

    // Extract category name from breadcrumbs
    const breadcrumbLinks = breadcrumbsNav?.querySelectorAll('a');
    let categoryName = null;

    breadcrumbLinks[0].textContent = 'KONAMI Web Store Support';
    // The category is typically the second-to-last link in breadcrumbs
    if (breadcrumbLinks && breadcrumbLinks.length >= 2) {
      const categoryLink = breadcrumbLinks[1];
      categoryName = categoryLink.textContent?.trim();
    }

    // Category-specific theme colors and assets (map category names to manifest settings)
    const categoryThemes = {
      'eFootball™': {
        primary: '{{settings.efootball_primary_color}}',
        secondary: '{{settings.efootball_secondary_color}}',
        bannerImage: '{{settings.efootball_banner_image}}',
        logo: '{{settings.efootball_logo}}'
      },
      'eBaseball™: MLB PRO SPIRIT': {
        primary: '{{settings.ebaseball_primary_color}}',
        secondary: '{{settings.ebaseball_secondary_color}}',
        bannerImage: '{{settings.ebaseball_banner_image}}',
        logo: '{{settings.ebaseball_logo}}'
      }
      // Add more games here as needed
    };

    if (categoryName && categoryThemes[categoryName]) {
      const theme = categoryThemes[categoryName];
      const mainContent = document.querySelector('#main-content');

      // Set banner image with responsive handling
      const heroSection = document.querySelector('[data-hero-section]');
      if (heroSection && theme.bannerImage) {
        const isMobile = window.innerWidth <= 768;
        let bannerImage;

        if (categoryName === 'eFootball™') {
          bannerImage = isMobile ? '{{settings.efootball_banner_mobile}}' : theme.bannerImage;

          if (bannerImage) {
            heroSection.style.backgroundImage = `url(${bannerImage})`;
            heroSection.style.backgroundSize = 'cover';
            heroSection.style.backgroundPosition = 'center center';
            heroSection.style.backgroundRepeat = 'no-repeat';
            heroSection.style.backgroundColor = '#00009d';
          }
        } else if (categoryName === 'eBaseball™: MLB PRO SPIRIT') {
          bannerImage = isMobile ? '{{settings.ebaseball_banner_mobile}}' : theme.bannerImage;

          if (bannerImage) {
            heroSection.style.backgroundImage = `url(${bannerImage})`;
            heroSection.style.backgroundSize = 'cover';
            heroSection.style.backgroundPosition = 'center center';
            heroSection.style.backgroundRepeat = 'no-repeat';
            heroSection.style.backgroundColor = '#121b28';
          }
        } else {
          bannerImage = theme.bannerImage;
        }
      }

      // Set logo
      const logoContainer = document.getElementById('category-logo');
      const logoImg = document.getElementById('category-logo-img');
      if (logoContainer && logoImg && theme.logo) {
        logoImg.src = theme.logo;
        logoContainer.style.display = 'block';
      }

      // Apply dynamic theming to the main content section
      mainContent.style.setProperty('--color-cta', theme.primary);
      mainContent.style.setProperty('--category-theme-primary', theme.primary);
      mainContent.style.setProperty('--category-theme-secondary', theme.secondary);

      // Apply eFootball theming to subsection buttons
      const subsectionBtns = document.querySelectorAll('.subsection-btn');
      subsectionBtns.forEach(btn => {
        btn.style.backgroundColor = theme.primary;
        btn.style.color = 'white';
        btn.style.borderColor = theme.primary;
        btn.addEventListener('mouseenter', function () {
          this.style.backgroundColor = theme.primary;
          this.style.opacity = '0.9';
        });
        btn.addEventListener('mouseleave', function () {
          this.style.backgroundColor = theme.primary;
          this.style.opacity = '1';
        });
      });

      // Apply eFootball theming to article buttons  
      const articleBtns = document.querySelectorAll('.article-btn');
      articleBtns.forEach(btn => {
        btn.style.borderColor = theme.primary;
        btn.style.color = theme.primary;
        btn.addEventListener('mouseenter', function () {
          this.style.backgroundColor = theme.primary;
          this.style.color = 'white';
        });
        btn.addEventListener('mouseleave', function () {
          this.style.backgroundColor = 'white';
          this.style.color = theme.primary;
        });
      });

      // Style the category link in breadcrumbs
      breadcrumbLinks.forEach((breadcrumb, index) => {
        const categoryLink = breadcrumbLinks[index];
        if (categoryLink) {
          categoryLink.style.setProperty('--hover-color', theme.primary);
          categoryLink.classList.add('category-themed');
        }
      });

      // Apply theming to hamburger button
      const hamburgerBtn = document.getElementById('hamburger-btn');
      if (hamburgerBtn) {
        hamburgerBtn.style.backgroundColor = theme.primary;
        hamburgerBtn.style.borderColor = theme.primary;
      }
    }

    // Add 'notranslate' class to breadcrumb links containing game names
    const breadcrumbLinksElement = document.querySelectorAll('.custom-breadcrumbs ol.breadcrumbs li a');
    breadcrumbLinksElement.forEach(link => {
      const linkText = link.textContent;
      if (linkText.includes('eFootball™') || linkText.includes('eBaseball™: MLB PRO SPIRIT') || linkText.includes('KONAMI Web Store Support')) {
        link.classList.add('notranslate');
      }
    });

    // Handle window resize for responsive banner images
    window.addEventListener('resize', function () {
      if (categoryName && categoryThemes[categoryName]) {
        const theme = categoryThemes[categoryName];
        const heroSection = document.querySelector('[data-hero-section]');

        if (heroSection && theme.bannerImage) {
          const isMobile = window.innerWidth <= 768;
          let bannerImage;

          if (categoryName === 'eFootball™') {
            bannerImage = isMobile ? '{{settings.efootball_banner_mobile}}' : theme.bannerImage;
          } else if (categoryName === 'eBaseball™: MLB PRO SPIRIT') {
            bannerImage = isMobile ? '{{settings.ebaseball_banner_mobile}}' : theme.bannerImage;
          } else {
            bannerImage = theme.bannerImage;
          }

          if (bannerImage) {
            heroSection.style.backgroundImage = `url(${bannerImage})`;
          }
        }
      }
    });
  });
</script>