<div class="gtranslate_wrapper"></div>
<!-- <section id="cc-hero-section" class="hero min-h-[30dvh] sm:min-h-[40dvh]" data-hero-section> -->
<section id="cc-hero-section" class="hero min-h-[30dvh] sm:min-h-[40dvh]" style="background-color: #242424;">
  <div class="hero-overlay"></div>
  <div class="hero-content w-full max-w-3xl text-neutral-content text-center">
    <div class="w-full">
      <div id="game-logo" class="mb-4" style="display: none;">
        <img id="game-logo-img" src="" alt="Game Logo" class="mx-auto max-h-20">
      </div>
      <h1 id="section-title" class="section-title mb-5 text-banner-text font-bold">
        {{section.name}}
      </h1>
      {{#if section.description}}
      <p class="text-banner-text mb-6">{{section.description}}</p>
      {{/if}}
      {{search
      instant=true
      class="input max-md:w-full md:w-2/3 lg:w-full focus-within:outline-sky-500 !text-main-text rounded-lg h-12 py-1"
      }}
    </div>
  </div>
</section>

<section id="main-content" class="flex-1 min-h-[50dvh] py-12 bg-white">
  <div class="flex flex-col max-w-5xl mx-auto px-4 xl:px-0">
    <!-- Breadcrumbs using Zendesk helper -->
    <nav class="custom-breadcrumbs text-sm mb-6">
      {{breadcrumbs}}
    </nav>

    <div class="w-full flex flex-col gap-4 mt-8">
      {{#if section.sections}}
      <div class="w-full mb-4 border-b border-gray-300 pb-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each section.sections}}
          <a href="{{url}}"
            class="btn btn-md h-[60px] flex items-center justify-between bg-cta !text-black hover:bg-cta/90 transition-colors rounded-lg text-start text-sm font-medium shadow-md subsection-btn">
            <div class="flex items-center gap-3">
              <i class="ph ph-folder text-lg"></i>
              <span class="line-clamp-1">{{name}}</span>
            </div>
            <i class="ph ph-arrow-right"></i>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if section.articles}}
      <div class="w-full">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each section.articles}}
          <a id="article-{{id}}" href="{{url}}"
            class="btn btn-md h-[50px] flex items-center justify-between border-2 border-cta bg-white text-black hover:bg-cta transition-colors rounded-lg text-start text-sm line-clamp-1 leading-4 shadow-sm article-btn">
            <span class="w-full line-clamp-1">
              {{title}}
            </span>
            <i class="ph ph-arrow-right"></i>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#unless section.sections}}{{#unless section.articles}}
      <div class="text-center py-8">
        <p class="text-main-text">No content available in this section yet.</p>
      </div>
      {{/unless}}{{/unless}}
    </div>
  </div>

  <section id="contact-support-section" class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 py-12 hidden">
    <div class="flex flex-col items-center">
      <div class="p-4 flex items-center justify-center rounded-full support-icon-bg">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#ffffff" viewBox="0 0 256 256">
          <path
            d="M144,180a16,16,0,1,1-16-16A16,16,0,0,1,144,180Zm92-52A108,108,0,1,1,128,20,108.12,108.12,0,0,1,236,128Zm-24,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128ZM128,64c-24.26,0-44,17.94-44,40v4a12,12,0,0,0,24,0v-4c0-8.82,9-16,20-16s20,7.18,20,16-9,16-20,16a12,12,0,0,0-12,12v8a12,12,0,0,0,23.73,2.56C158.31,137.88,172,122.37,172,104,172,81.94,152.26,64,128,64Z">
          </path>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-main-text !mt-4">Need Assistance?</h3>
      <p class="text-main-text text-center mt-2">Can't find what you're looking for? Our support team is here to help.
      </p>
      <a href="{{page_path 'new_request'}}"
        class="btn bg-cta hover:bg-cta/90 border-none shadow-none text-cta-text mt-4 contact-support-btn">
        Contact Support
      </a>
    </div>
  </section>
</section>

<script src="{{asset 'scripts/section.js'}}"></script>