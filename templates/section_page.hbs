<section id="cc-hero-section" class="hero min-h-[40dvh]"
	style="background-image: url({{settings.efootball_banner_image}});">
	<div class="hero-overlay"></div>
	<div class="hero-content w-full max-w-3xl text-neutral-content text-center">
		<div class="w-full">
			{{#if settings.efootball_logo}}
			<div class="mb-4">
				<img src="{{settings.efootball_logo}}" alt="eFootball Logo" class="mx-auto max-h-20">
			</div>
			{{/if}}
			<h1 class="mb-5 text-banner-text font-bold">
				{{section.name}}
			</h1>
			{{#if section.description}}
			<p class="text-banner-text mb-6">{{section.description}}</p>
			{{/if}}
		</div>
	</div>
</section>

<section id="main-content" class="flex-1 min-h-[50dvh] py-12 bg-white">
  <div class="flex flex-col max-w-5xl mx-auto px-4 xl:px-0">
    <!-- Breadcrumbs using Zendesk helper -->
    <nav class="custom-breadcrumbs text-sm mb-6">
      {{breadcrumbs}}
    </nav>


    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
      {{#each section.articles}}
      <a id="article-{{id}}" href="{{url}}"
        class="btn btn-md h-[50px] flex items-center justify-between border-2 border-cta bg-white text-cta hover:bg-cta !hover:text-white transition-colors rounded-lg text-start text-sm line-clamp-1 leading-4 shadow-sm">
        <span class="w-full line-clamp-1">
          {{title}}
        </span>
      </a>
      {{/each}}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const breadcrumbsNav = document.querySelector('.custom-breadcrumbs');

    // Extract category name from breadcrumbs
    const breadcrumbLinks = breadcrumbsNav?.querySelectorAll('a');
    let categoryName = null;

    // The category is typically the second-to-last link in breadcrumbs
    if (breadcrumbLinks && breadcrumbLinks.length >= 2) {
      const categoryLink = breadcrumbLinks[breadcrumbLinks.length - 2];
      categoryName = categoryLink.textContent?.toLowerCase().trim();
    }

    // Category-specific theme colors (map category names to manifest settings)
    const categoryThemes = {
      'efootball': {
        primary: '{{settings.efootball_primary_color}}',
        secondary: '{{settings.efootball_secondary_color}}'
      }
      // Add more games here as needed
    };

    if (categoryName && categoryThemes[categoryName]) {
      const theme = categoryThemes[categoryName];
      const mainContent = document.querySelector('#main-content');

      // Apply dynamic theming to the main content section
      mainContent.style.setProperty('--color-cta', theme.primary);
      mainContent.style.setProperty('--category-theme-primary', theme.primary);
      mainContent.style.setProperty('--category-theme-secondary', theme.secondary);

      // Style the category link in breadcrumbs
      const categoryLink = breadcrumbLinks[breadcrumbLinks.length - 2];
      if (categoryLink) {
        categoryLink.style.setProperty('--hover-color', theme.primary);
        categoryLink.classList.add('category-themed');
      }
    }
  });
</script>

