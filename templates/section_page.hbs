<section id="cc-hero-section" class="hero min-h-[40dvh]"
  style="background-image: url('{{settings.homepage_background_image}}');">
  <div class="hero-overlay"></div>
  <div class="hero-content w-full max-w-3xl text-neutral-content text-center">
    <div class="w-full">
      <h1 class="mb-5 text-white font-bold">
        {{dc 'hc_-_how_can_we_help'}}
      </h1>
      {{search
      instant=true
      class="input max-md:w-full md:w-2/3 lg:w-full focus-within:outline-sky-500 rounded-lg text-black h-12 py-1"
      }}
    </div>
  </div>
</section>

<section id="main-content" class="flex-1 h-full py-12 bg-white">
  <div class="flex flex-col max-w-5xl mx-auto px-4 xl:px-0">
    <h2 class="text-xl md:text-2xl text-start text-fc-dark font-semibold mt-4">
      {{section.name}}
    </h2>
    <p class="text-md text-start text-fc-dark mt-2">
      {{section.description}}
    </p>

    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
      {{#each section.articles}}
      <a id="article-{{id}}" href="{{url}}"
        class="btn btn-md h-[50px] flex items-center justify-between border-2 border-brand bg-brand/90 hover:bg-brand transition-colors rounded-lg text-cta-text text-start text-sm line-clamp-1 leading-4 shadow-sm">
        <span class="w-full line-clamp-1">
          {{title}}
        </span>
      </a>
      {{/each}}
    </div>
  </div>
</section>