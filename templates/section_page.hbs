<!-- Hero Section -->
<section id="cc-hero-section" class="hero relative min-h-[500px] sm:min-h-[425px] overflow-visible z-0"
  style="background-color: #280031;">
  <div class="hero-overlay"></div>
  <div
    class="relative hero-content w-full h-full max-w-5xl text-neutral-content text-center z-10 py-16 flex flex-col items-center max-sm:justify-start">
    <div class="w-full h-full z-10">
      <h1 class="mb-5 text-banner-text text-[48px] sm:text-[64px] font-ott font-bold">
        {{dc 'hc_-_how_can_we_help'}}
      </h1>
      <h2 class="mb-5 text-base sm:text-xl">
        <span class="text-green-400">
          85%
        </span>
        of users resolve issues using Codee
      </h2>
      <button id="ask-codee"
        class="bg-[#E8F953] !inline-flex text-brand-text font-bold text-xl btn w-max rounded-full px-[28px] py-[13px] sm:py-[16px]">
        Chat with Codee
      </button>
    </div>

    <img src="{{asset 'codee.webp'}}" alt="" aria-hidden="true"
      class="pointer-events-none select-none absolute max-sm:bottom-4 -bottom-8 right-10 w-[177px] min-[500px]:w-[222px] md:w-[272px] z-5">
  </div>

  <!-- Torn-paper edge: blends the hero into the page background -->
  <img src="{{asset 'tear2.webp'}}" alt="" aria-hidden="true"
    class="pointer-events-none select-none absolute object-cover bottom-0 w-full h-16 z-1">
</section>

<section id="main-content" class="flex-1 min-h-[50dvh] max-md:w-full lg:w-full mx-auto px-5 py-8">
  <div class="flex flex-col max-w-5xl mx-auto px-4 xl:px-0">
    <!-- Breadcrumbs using Zendesk helper -->
    <nav class="custom-breadcrumbs text-sm mb-6">
      {{breadcrumbs}}
    </nav>

    <div class="w-full flex flex-col gap-4 mt-8">
      {{#if section.sections}}
      <div class="w-full mb-4 border-b border-gray-300 pb-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each section.sections}}
          <a href="{{url}}"
            class="btn btn-md h-[60px] flex items-center justify-between bg-brand text-brand-text hover:bg-brand/90 hover:text-white transition-colors rounded-lg text-start text-sm font-medium shadow-md subsection-btn">
            <div class="flex items-center gap-3">
              <i class="ph ph-folder text-lg"></i>
              <span class="line-clamp-1">{{name}}</span>
            </div>
            <i class="ph ph-arrow-right"></i>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if section.articles}}
      <div class="w-full">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each section.articles}}
          <a id="article-{{id}}" href="{{url}}"
            class="btn btn-md h-[50px] flex items-center justify-between border-2 border-brand bg-transparent text-brand-text hover:bg-brand hover:text-white transition-colors rounded-lg text-start text-sm line-clamp-1 leading-4 shadow-sm article-btn">
            <span class="w-full line-clamp-1">
              {{title}}
            </span>
            <i class="ph ph-arrow-right"></i>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#unless section.sections}}{{#unless section.articles}}
      <div class="text-center py-8">
        <p class="text-main-text">No content available in this section yet.</p>
      </div>
      {{/unless}}{{/unless}}
    </div>
  </div>
</section>

<script defer type="text/javascript" src="https://prod-au-druid-cdn.azureedge.net/v2/druid_webchat_v2.js"></script>
<script data-druid-language="ms" type="text/javascript">
  const botId = "{{settings.druid_bot_id}}";
  const botQueryParams = "{{settings.druid_query_params}}";

  document.addEventListener("DOMContentLoaded", function (event) {
    DruidWebchat_v2.init({
      botId: botId,
      baseUrl: "https://druidapi.au.druidplatform.com",
      queryParams: botQueryParams,
      UI: {
        containerElement: document.getElementById('ask-codee'),
        height: '80dvh'
      }
    });
  });
</script>