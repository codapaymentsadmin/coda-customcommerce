<!-- Hero Section -->
<section id="cc-hero-section" class="hero relative min-h-[550px] sm:min-h-[450px] overflow-visible z-0"
	style="background-color: #280031;">
	<div class="hero-overlay"></div>
	<div
		class="relative hero-content w-full max-w-5xl text-neutral-content text-center z-10 py-8 flex flex-col items-center justify-center">
		<div class="w-full z-10">
			<h1 class="mb-5 text-banner-text text-[48px] sm:text-[64px] font-ott font-bold">
				{{dc 'hc_-_how_can_we_help'}}
			</h1>
			<h2 id="codee-resolve" class="mb-5 text-base sm:text-xl">
				{{dc 'hc_-_codee_resolve'}}
			</h2>
			<button id="ask-codee"
				class="bg-[#E8F953] !inline-flex text-brand-text font-bold text-xl btn w-max rounded-full px-[28px] py-[13px] sm:py-[16px]">
				{{dc 'hc_-_chat_with_codee'}}
			</button>
		</div>

		<!-- Mobile Codee -->
		<img src="{{asset 'codee.webp'}}" alt="Codee" aria-hidden="true"
			class="block md:hidden pointer-events-none select-none mt-10 self-end mr-4 -mb-8 w-[177px] min-[500px]:w-[222px] z-5">
		<!-- Desktop Codee -->
		<img src="{{asset 'codee.webp'}}" alt="Codee" aria-hidden="true"
			class="hidden md:block pointer-events-none select-none absolute -bottom-28 right-4 w-[222px] lg:w-[272px] z-5">
	</div>

	<!-- Torn-paper edge: blends the hero into the page background -->
	<img id="tear-desktop" src="{{asset 'tear.webp'}}" alt="tear background" aria-hidden="true"
		class="hidden sm:block pointer-events-none select-none absolute object-cover bottom-0 w-full h-18 z-1">
	<img id="tear-mobile" src="{{asset 'tear-mobile.webp'}}" alt="tear background" aria-hidden="true"
		class="block sm:hidden pointer-events-none select-none absolute object-cover bottom-0 w-full h-18 z-1">
</section>

<section class="max-w-5xl max-md:w-full md:w-2/3 min-h-[50dvh] lg:w-full mx-auto px-4 py-12">
	<section class="flex-1 flex items-start mt-6">
		<aside id="promoted-articles-section" class="w-full md:w-1/3 h-max">
			<!-- <h3 class="text-md font-semibold">{{dc 'hc_-_articles_in_this_section'}}</h3> -->
			<h3 class="text-md font-semibold">{{t 'featured_posts'}}</h3>
			<div class="w-full join join-vertical mt-2 gap-2">
				{{#each promoted_articles}}
				<a href="{{url}}"
					class="btn btn-md h-[50px] flex items-center justify-start border-brand text-white transition-colors bg-brand hover:bg-brand/90 rounded-lg text-start text-sm line-clamp-2 leading-4">
					{{title}}
				</a>
				{{/each}}
			</div>
		</aside>
		<section class="w-full md:w-[75%] flex flex-col px-4">
			<h2 class="text-lg w-full font-semibold pb-4">
				{{t "preview_result_header" query=query}}
			</h2>
			{{#if results}}
			<hr class="w-full border-1.5 border-ott-tertiary/50" />
			<div class="w-full flex flex-col gap-4 pt-4">
				{{#each results}}
				<a href="{{url}}"
					class="flex-1 flex flex-col justify-start px-4 py-2 rounded-md box-border border border-transparent hover:border-brand cursor-pointer">
					<h3 class="text-lg text-brand transition-colors font-bold">
						{{title}}
					</h3>
					<p class="text-main-text !text-sm mt-1.5">
						{{text}}
					</p>
				</a>
				{{/each}}
			</div>
			{{pagination}}
			{{else}}
			<p class="text-main-text font-semibold">
				{{t "no_results_unified"}}
			</p>
			{{/if}}
		</section>
	</section>
</section>