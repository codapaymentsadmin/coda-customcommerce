<section id="contact-support" class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 pt-16 pb-12">
	<!-- Breadcrumbs using Zendesk helper -->
	<nav class="custom-breadcrumbs text-sm mb-6">
		{{breadcrumbs}}
	</nav>
	
	<div class="w-full">
		<h2 class="text-2xl font-bold text-main-text mb-4">Contact Support</h2>
		<p class="text-main-text">Need help? Fill out the form below and our support team will get back to you as soon as possible.</p>
	</div>
</section>

<section id="submit-request" class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 py-12">
	<div class="w-full bg-white p-6 rounded-lg shadow-md">
		{{request_form wysiwyg=true}}
		<p id="ingame-warning" class="hidden text-black !text-base mt-2">
			<span>
				<i class="ph ph-bold ph-warning text-yellow-500"></i>
			</span>
			<strong>For in-game inquiries:</strong> Please make sure to include your Player ID, Server, and detailed description of the issue.
			<span>
				<a href="{{settings.webstore_helpcenter_link}}" target="_blank" class="warning-hc-link">
					{{settings.webstore_helpcenter_link_text}}
				</a>
			</span>
		</p>
	</div>
</section>