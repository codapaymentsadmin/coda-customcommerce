<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Break the URL path into parts and ignore any trailing slashes
    var pathParts = window.location.pathname.split('/').filter(Boolean);
    
    // If the path has more than 2 parts, it means the user is viewing an article, category, form, etc.
    if (pathParts.length > 2) {
      var headerSubmitBtn = document.querySelector('.submit-a-request-header-btn');
      if (headerSubmitBtn) {
        // Hides the button using the 'important' override so it beats the CSS
        headerSubmitBtn.style.setProperty("display", "none", "important"); 
      }
    }
  });
</script>
