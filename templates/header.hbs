<script>
// 1. Automatically grab the current Help Center's name (e.g., "Codashop Timor Leste")
var currentHC = "{{help_center.name}}";

// 2. Change "Codashop" to "Coda Payments Support" to match your Chat Department exactly
var targetDept = currentHC.replace("Codashop", "Coda Payments Support");

// 3. Run the widget using the new automatic targetDept variable
zE('webWidget:on', 'chat:departmentStatus', function(dept) {
  if (dept.name === targetDept && dept.status === 'online') {
    console.log(dept.name + ' is ' + dept.status);      //optional logging
    zE('webWidget', 'updateSettings', {
      webWidget: {
        chat: {
          departments: {
            enabled: [''],
            select: targetDept
          },
          suppress: false
        }
      }
    });
  } else if (dept.name === targetDept && dept.status !== 'online') {
    console.log(dept.name + ' is ' + dept.status);      //optional logging
    zE('webWidget', 'updateSettings', {
      webWidget: {
        chat: {
          suppress: true
        }
      }
    });
  }
});
</script>
<script type="text/javascript">
