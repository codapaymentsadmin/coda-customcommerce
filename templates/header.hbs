<!-- Critical Infobar -->
<section id="infobar-container" class="w-full flex flex-col">
	{{#if settings.show_warning_infobar_global}}
	<div id="infobar-component"
		class="critical infobar-component w-full flex items-center justify-center bg-crit-infobar-bg h-[60px]">
		<div role="alert"
			class="alert w-full bg-transparent flex items-center max-w-7xl mx-auto border-x-0 border-y-0 px-4 py-2 rounded-none shadow-none">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 256 256"
				class="!text-crit-infobar-text">
				<path
					d="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z">
				</path>
			</svg>
			<div id="infobar-content">
				<p class="!text-xs sm:!text-sm text-crit-infobar-text font-bold">
					{{dc "cc_help_center_infobar_content"}}
				</p>
			</div>
		</div>
	</div>
	{{/if}}

	<!-- Infobar General -->
	{{#if settings.show_infobar_global}}
	<div id="infobar-component"
		class="infobar-component w-full items-center justfy-center bg-infobar-bg h-[50px] sm:h-[40px]">
		<div role="alert"
			class="alert bg-transparent flex items-center max-w-7xl mx-auto border-x-0 border-y-0 px-4 py-2 rounded-none">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 256 256"
				class="!text-infobar-text">
				<path
					d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z">
				</path>
			</svg>
			<div id="infobar-content">
				<p class="!text-xs sm:!text-sm text-infobar-text font-bold">
					{{dc "cc_help_center_infobar_content"}}
				</p>
			</div>
			<span class="infobar-dismiss ms-auto cursor-pointer">
				<i class="ph ph-x text-infobar-text"></i>
			</span>
		</div>
	</div>
	{{/if}}
</section>

<!-- Navbar -->
<header class="w-full bg-navbar-bg shadow-lg">
	<div class="navbar max-w-7xl mx-auto">
		<div class="flex-1">
			<a id="brand-name" href="{{page_path 'help_center'}}"
				class="link no-underline text-base sm:text-md text-brand-text tracking-tight notranslate">
				{{settings.brand_name}}
			</a>
		</div>
		<div class="flex-none">
			<ul class="menu menu-horizontal hidden sm:flex items-center px-1">
				<li>
					<a id="dynamic-link" href="" data-contact-text="Contact Support" class="text-white hover:underline mr-2"></a>
				</li>
				{{#if alternative_locales}}
				<div class="divider divider-horizontal after:bg-white before:bg-white"></div>
				<li>
					<details>
						<summary class="font-normal text-white hover:text-cta hover:underline">
							{{current_locale.name}}</summary>
						<ul class="bg-white shadow-sm border border-gray-200 rounded-t-none p-2">
							{{#each alternative_locales}}
							<li><a href="{{url}}" dir="{{direction}}" class="text-brand-text">{{name}}</a></li>
							{{/each}}
						</ul>
					</details>
				</li>
				{{/if}}
			</ul>
			<div id="hamburger-btn" tabindex="0" role="button"
				class="btn btn-soft btn-brand border-none shadow-none bg-brand text-cta-text sm:hidden">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" stroke="currentColor"
					viewBox="0 0 256 256">
					<path
						d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z">
					</path>
				</svg>
			</div>
		</div>
	</div>
	<!-- Menu drawer on mobile -->
	<div id="mobile-drawer" class="w-full bg-black border-t border-gray-800 shadow-lg hidden sm:hidden">
		<div class="max-w-7xl mx-auto px-4 py-6">
			<nav class="space-y-4">
				<!-- Dynamic Link (Contact/Help Center) -->
				<a id="dynamic-link-mobile" data-contact-text="Contact Support" href=""
					class="block py-3 px-4 text-white border border-white hover:bg-cta hover:border-cta hover:text-white rounded-lg transition-colors">
				</a>

				{{#if alternative_locales}}
				<!-- Language Selector -->
				<div class="border-t border-gray-600 pt-4 mt-4">
					<p class="text-sm font-semibold text-gray-300 mb-2">Language</p>
					<details class="group">
						<summary
							class="block py-3 px-4 text-white border border-white hover:bg-cta hover:border-cta hover:text-white rounded-lg transition-colors cursor-pointer list-none">
							<div class="flex items-center justify-between">
								<span>{{current_locale.name}}</span>
								<i class="ph ph-caret-down text-sm group-open:rotate-180 transition-transform"></i>
							</div>
						</summary>
						<div class="mt-2 space-y-1 pl-4">
							{{#each alternative_locales}}
							<a href="{{url}}" dir="{{direction}}"
								class="block py-2 px-3 text-sm text-gray-300 hover:text-cta rounded transition-colors">
								{{name}}
							</a>
							{{/each}}
						</div>
					</details>
				</div>
				{{/if}}
			</nav>
		</div>
	</div>
</header>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		// Category-specific theme colors and assets (map category names to manifest settings)
		const categoryThemes = {
			'efootball': {
				primary: '{{settings.efootball_primary_color}}',
				secondary: '{{settings.efootball_secondary_color}}'
			},
			'ebaseball': {
				primary: '{{settings.blockman_primary_color}}',
				secondary: '{{settings.blockman_secondary_color}}'
			}
		};

		// Detect game category from URL path or page title
		const pagePath = window.location.pathname.toLowerCase();
		const pageTitle = document.querySelector('h1')?.textContent?.toLowerCase().trim();

		let detectedCategory = null;

		// Check URL path first
		if (pagePath.includes('efootball')) {
			detectedCategory = 'efootball';
		} else if (pagePath.includes('ebaseball')) {
			detectedCategory = 'ebaseball';
		}

		// If not found in path, check page title
		if (!detectedCategory && pageTitle) {
			if (pageTitle.includes('efootball')) {
				detectedCategory = 'efootball';
			} else if (pageTitle.includes('ebaseball')) {
				detectedCategory = 'ebaseball';
			}
		}

		// Apply theming if a category is detected
		if (detectedCategory && categoryThemes[detectedCategory]) {
			const theme = categoryThemes[detectedCategory];
			const hamburgerBtn = document.getElementById('hamburger-btn');

			if (hamburgerBtn) {
				hamburgerBtn.style.backgroundColor = theme.primary;
				hamburgerBtn.style.borderColor = theme.primary;
			}
		}
	});
</script>