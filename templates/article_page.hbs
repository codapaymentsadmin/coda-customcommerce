<!-- Hero Section -->
<section id="cc-hero-section" class="hero relative min-h-[500px] sm:min-h-[425px] overflow-visible z-0"
  style="background-color: #280031;">
  <div class="hero-overlay"></div>
  <div
    class="relative hero-content w-full h-full max-w-5xl text-neutral-content text-center z-10 py-16 flex flex-col items-center max-sm:justify-start">
    <div class="w-full h-full z-10">
      <h1 class="mb-5 text-banner-text text-[48px] sm:text-[64px] font-ott font-bold">
        {{dc 'hc_-_how_can_we_help'}}
      </h1>
      <h2 class="mb-5 text-base sm:text-xl">
        <span class="text-green-400">
          85%
        </span>
        of users resolve issues using Codee
      </h2>
      <button id="ask-codee"
        class="bg-[#E8F953] !inline-flex text-brand-text font-bold text-xl btn w-max rounded-full px-[28px] py-[13px] sm:py-[16px]">
        Chat with Codee
      </button>
    </div>

    <img src="{{asset 'codee.webp'}}" alt="" aria-hidden="true"
      class="pointer-events-none select-none absolute max-sm:bottom-4 -bottom-8 right-10 w-[177px] min-[500px]:w-[222px] md:w-[272px] z-5">
  </div>

  <!-- Torn-paper edge: blends the hero into the page background -->
  <img src="{{asset 'tear2.webp'}}" alt="" aria-hidden="true"
    class="pointer-events-none select-none absolute object-cover bottom-0 w-full h-16 z-1">
</section>

<section class="max-w-5xl max-md:w-full lg:w-full min-h-[40dvh] mx-auto px-5 py-8">
  <!-- Breadcrumbs using Zendesk helper -->
  <nav class="custom-breadcrumbs text-sm mb-6">
    {{breadcrumbs}}
  </nav>
  <div class="article-container" id="article-container">
    <aside id="similar-articles-section"
      class="w-full lg:w-1/3 h-max pt-4 sm:pt-0 border-t-2 sm:border-t-0 border-cta-text sm:order-1 order-2">
      <h2 class="font-semibold">{{dc 'hc_-_articles_in_this_section'}}</h2>
      <div class="flex-1 flex flex-col mt-2 gap-2">
        {{#each section.articles}}
        <a href="{{url}}"
          class="btn btn-xl flex items-center justify-start {{#is id ../article.id}}bg-brand text-white{{else}}border-2 bg-transparent border-brand text-brand-text
          hover:bg-brand hover:border-brand hover:text-white {{/is}} transition-colors rounded-lg text-start text-xs sm:text-sm leading-4 article-sidebar-btn">
          {{title}}
        </a>
        {{/each}}
      </div>
    </aside>

    <article id="main-content" class="article sm:mt-8 lg:mt-0 sm:order-2 order-1">
      <header class="article-title-header mb-6">
        <h1 class="text-3xl font-bold text-main-text">
          {{article.title}}
          {{#if article.internal}}
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" focusable="false" viewBox="0 0 16 16"
            class="icon-lock text-main-text ml-2 inline-block" title="{{t 'internal'}}">
            <rect width="12" height="9" x="2" y="7" fill="currentColor" rx="1" ry="1" />
            <path fill="none" stroke="currentColor" d="M4.5 7.5V4a3.5 3.5 0 017 0v3.5" />
          </svg>
          {{/if}}
        </h1>
      </header>

      <section class="article-info">
        <div class="article-content">
          <div class="article-body">{{article.body}}</div>

          {{#if (compare article.content_tags.length ">" 0)}}
          <section class="content-tags">
            <p>{{t 'content_tags_label'}}</p>
            <ul class="content-tag-list">
              {{#each article.content_tags}}
              <li class="content-tag-item" data-content-tag-id="{{id}}">
                {{#link "search_result" content_tag_id=id}}
                {{name}}
                {{/link}}
              </li>
              {{/each}}
            </ul>
          </section>
          {{/if}}

          {{#if attachments}}
          <div class="article-attachments">
            <ul class="attachments">
              {{#each attachments}}
              <li class="attachment-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" focusable="false" viewBox="0 0 16 16"
                  class="attachment-icon">
                  <path fill="none" stroke="currentColor" stroke-linecap="round"
                    d="M9.5 4v7.7c0 .8-.7 1.5-1.5 1.5s-1.5-.7-1.5-1.5V3C6.5 1.6 7.6.5 9 .5s2.5 1.1 2.5 2.5v9c0 1.9-1.6 3.5-3.5 3.5S4.5 13.9 4.5 12V4" />
                </svg>
                <a href="{{url}}" target="_blank">{{name}}</a>
                <div class="attachment-meta meta-group">
                  <span class="attachment-meta-item meta-data">{{size}}</span>
                  <a href="{{url}}" target="_blank" class="attachment-meta-item meta-data">{{t 'download'}}</a>
                </div>
              </li>
              {{/each}}
            </ul>
          </div>
          {{/if}}
        </div>
      </section>
    </article>
  </div>
</section>

<script defer type="text/javascript" src="https://prod-au-druid-cdn.azureedge.net/v2/druid_webchat_v2.js"></script>
<script data-druid-language="ms" type="text/javascript">
  const botId = "{{settings.druid_bot_id}}";
  const botQueryParams = "{{settings.druid_query_params}}";

  document.addEventListener("DOMContentLoaded", function (event) {
    DruidWebchat_v2.init({
      botId: botId,
      baseUrl: "https://druidapi.au.druidplatform.com",
      queryParams: botQueryParams,
      UI: {
        containerElement: document.getElementById('ask-codee'),
        height: '80dvh'
      }
    });
  });
</script>