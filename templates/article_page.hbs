<!-- Hero Section -->
<section id="cc-hero-section" class="hero min-h-[40dvh]" data-hero-section>
  <div class="hero-overlay"></div>
</section>

<section class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 py-12 notranslate">
  <!-- Breadcrumbs using Zendesk helper -->
  <nav class="custom-breadcrumbs text-sm mb-6">
    {{breadcrumbs}}
  </nav>

  <div class="article-container" id="article-container">
    <aside id="similar-articles-section"
      class="w-full lg:w-1/3 h-max pt-4 sm:pt-0 border-t-2 sm:border-t-0 border-cta-text sm:order-1 order-2">
      <h2 class="text-md font-semibold">Articles in this section</h2>
      <div class="w-full join join-vertical mt-2 gap-2">
        {{#each section.articles}}
        <a href="{{url}}"
          class="btn btn-md w-full min-h-[50px] flex items-center justify-start {{#is id ../article.id}}bg-cta text-cta-text{{else}}border-2 border-cta text-cta{{/is}} hover:bg-cta hover:text-cta-text transition-colors rounded-lg text-start text-sm line-clamp-1 leading-4 article-sidebar-btn">
          {{title}}
        </a>
        {{/each}}
      </div>
    </aside>

    <article id="main-content" class="article min-h-[40dvh] sm:mt-8 lg:mt-0 sm:order-2 order-1">
      {{#if article.internal}}
      <header class="article-header">
        <div class="flex items-center gap-2 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" focusable="false" viewBox="0 0 16 16"
            class="icon-lock text-main-text" title="{{t 'internal'}}">
            <rect width="12" height="9" x="2" y="7" fill="currentColor" rx="1" ry="1" />
            <path fill="none" stroke="currentColor" d="M4.5 7.5V4a3.5 3.5 0 017 0v3.5" />
          </svg>
          <span class="text-main-text text-sm">{{t 'internal'}}</span>
        </div>
      </header>
      {{/if}}

      <section class="article-info">
        <div class="article-content">
          <header class="article-title-header mb-6">
            <h1 class="text-3xl font-bold text-main-text">
              {{article.title}}
              {{#if article.internal}}
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" focusable="false" viewBox="0 0 16 16"
                class="icon-lock text-main-text ml-2 inline-block" title="{{t 'internal'}}">
                <rect width="12" height="9" x="2" y="7" fill="currentColor" rx="1" ry="1" />
                <path fill="none" stroke="currentColor" d="M4.5 7.5V4a3.5 3.5 0 017 0v3.5" />
              </svg>
              {{/if}}
            </h1>
          </header>
          <div class="article-body">{{article.body}}</div>

          {{#if (compare article.content_tags.length ">" 0)}}
          <section class="content-tags">
            <p>{{t 'content_tags_label'}}</p>
            <ul class="content-tag-list">
              {{#each article.content_tags}}
              <li class="content-tag-item" data-content-tag-id="{{id}}">
                {{#link "search_result" content_tag_id=id}}
                {{name}}
                {{/link}}
              </li>
              {{/each}}
            </ul>
          </section>
          {{/if}}

          {{#if attachments}}
          <div class="article-attachments">
            <ul class="attachments">
              {{#each attachments}}
              <li class="attachment-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" focusable="false" viewBox="0 0 16 16"
                  class="attachment-icon">
                  <path fill="none" stroke="currentColor" stroke-linecap="round"
                    d="M9.5 4v7.7c0 .8-.7 1.5-1.5 1.5s-1.5-.7-1.5-1.5V3C6.5 1.6 7.6.5 9 .5s2.5 1.1 2.5 2.5v9c0 1.9-1.6 3.5-3.5 3.5S4.5 13.9 4.5 12V4" />
                </svg>
                <a href="{{url}}" target="_blank">{{name}}</a>
                <div class="attachment-meta meta-group">
                  <span class="attachment-meta-item meta-data">{{size}}</span>
                  <a href="{{url}}" target="_blank" class="attachment-meta-item meta-data">{{t 'download'}}</a>
                </div>
              </li>
              {{/each}}
            </ul>
          </div>
          {{/if}}
        </div>
      </section>
    </article>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Extract category name from breadcrumbs
    const breadcrumbsNav = document.querySelector('.custom-breadcrumbs');
    const breadcrumbLinks = breadcrumbsNav?.querySelectorAll('a');
    let categoryName = null;

    // The category is typically the second-to-last link in breadcrumbs
    if (breadcrumbLinks && breadcrumbLinks.length >= 2) {
      const categoryLink = breadcrumbLinks[1];
      categoryName = categoryLink.textContent?.toLowerCase().trim();
    }

    // Category-specific theme colors and assets (map category names to manifest settings)
    const categoryThemes = {
      'efootball': {
        primary: '{{settings.efootball_primary_color}}',
        secondary: '{{settings.efootball_secondary_color}}',
        bannerImage: '{{settings.efootball_banner_image}}',
        logo: '{{settings.efootball_logo}}'
      },
      'ebaseball': {
        primary: '{{settings.ebaseball_primary_color}}',
        secondary: '{{settings.ebaseball_secondary_color}}',
        bannerImage: '{{settings.ebaseball_banner_image}}',
        logo: '{{settings.ebaseball_logo}}'
      }
      // Add more games here as needed
    };

    if (categoryName && categoryThemes[categoryName]) {
      const theme = categoryThemes[categoryName];

      // Set banner image
      const heroSection = document.querySelector('[data-hero-section]');
      if (heroSection && theme.bannerImage) {
        heroSection.style.backgroundImage = `url(${theme.bannerImage})`;
      }

      // Apply dynamic theming to sidebar buttons
      const sidebarBtns = document.querySelectorAll('.article-sidebar-btn');
      sidebarBtns.forEach(btn => {
        if (btn.classList.contains('bg-cta')) {
          // Active button - use inline styles for dynamic theming
          btn.style.backgroundColor = theme.primary;
          btn.style.color = 'white';
        } else {
          // Inactive buttons - use inline styles for dynamic theming
          btn.style.borderColor = theme.primary;
          btn.style.color = theme.primary;
          btn.addEventListener('mouseenter', function () {
            this.style.backgroundColor = theme.primary;
            this.style.color = 'white';
          });
          btn.addEventListener('mouseleave', function () {
            this.style.backgroundColor = 'white';
            this.style.color = theme.primary;
          });
        }
      });

      // Apply dynamic theming to article body links
      const articleContainer = document.querySelector('.article');
      if (articleContainer) {
        articleContainer.classList.add(`${categoryName}-themed`);
      }

      // Style the category link in breadcrumbs
      breadcrumbLinks.forEach((breadcrumb, index) => {
        const categoryLink = breadcrumbLinks[index];
        if (categoryLink) {
          categoryLink.style.setProperty('--hover-color', theme.primary);
          categoryLink.classList.add('category-themed');
        }
      })
    }
  });
</script>