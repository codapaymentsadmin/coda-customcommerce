<footer id="footer-v2" class="max-w-5xl mx-auto bg-footer-bg text-brand px-5 py-8">
	<hr class="block sm:hidden w-full h-4 px-5 border-t-2 border-gray-300">
	</hr>
	<div class="w-full flex items-center justify-between gap-4">
		<aside class="flex flex-col items-start gap-1">
			{{#if settings.show_terms_link}}
			<a href="{{settings.privacy_link}}" class="link link-hover text-sm font-semibold"> {{dc 'hc_-_privacy_policy'}}
			</a>
			{{/if}}
			{{#if settings.show_pp_link}}
			<a href="{{settings.terms_link}}" class="link link-hover text-sm font-semibold">
				{{dc 'hc_-_terms_and_conditions'}}
			</a>
			{{/if}}
		</aside>
		<nav class="">
			{{#if alternative_locales}}
			<details class="dropdown dropdown-top dropdown-end">
				<summary class="btn max-w-[250px] btn-ghost btn-brand flex items-center hover:bg-brand hover:text-white">
					<i class="max-sm:hidden ph ph-globe text-xl"></i>
					<span class="text-start text-sm">
						{{current_locale.name}}
					</span>
					<i class="ph ph-caret-down text-sm"></i>
				</summary>
				<ul
					class="w-54 menu dropdown-content bg-footer-bg shadow-sm border border-brand p-2 max-h-[400px] overflow-y-scroll rounded-xl">
					{{#each alternative_locales}}
					<li><a href="{{url}}" dir="{{direction}}" class="text-brand text-sm">{{name}}</a></li>
					{{/each}}
				</ul>
			</details>
			{{/if}}
		</nav>
	</div>
</footer>