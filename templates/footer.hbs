<footer class="footer sm:footer-horizontal bg-footer-bg text-main-text items-center p-4 border-t border-gray-100">
	<div class="w-full flex flex-wrap items-start sm:items-center justify-between gap-2">
		<div class="max-w-lg flex flex-col items-start">
			<h4 id="footer-brand-name" class="font-semibold text-white !text-xl notranslate">
				{{settings.brand_name}} {{dc 'hc_-_help_center'}}
			</h4>
			<p class="text-white !text-sm mt-2">
				THE OFFICIAL YALLA LIVE WEB STORE IS OPERATED BY CODA. CODA IS AN AUTHORIZED RESELLER OF DIGITAL CONTENT FOR
				YALLA
			</p>
			<div class="flex items-center mt-2">
				<p class="text-white !text-sm">
					Powered by
				</p>
				<span class="ms-1.5">
					<img src="{{settings.coda_logo}}" alt="Coda Logo" class="h-4">
				</span>
				</>
			</div>
		</div>
		{{#if settings.show_copyright}}
		<p class="!text-sm text-white notranslate">
			<span class="copyright"></span>
			{{settings.copyright_text}}
		</p>
		{{/if}}
</footer>