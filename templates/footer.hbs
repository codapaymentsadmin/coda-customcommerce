<footer class="footer sm:footer-horizontal bg-footer-bg text-main-text items-center p-4 border-t border-gray-100">
	<div class="w-full flex flex-wrap items-start sm:items-center justify-between gap-1">
		<h4 class="font-semibold text-white text-lg sm:text-xl notranslate">{{settings.brand_name}}</h4>
		<div class="flex max-sm:flex-col sm:items-center gap-3">
			<p id="master-duel_copyright" class="!text-sm text-white sm:border-r-2 border-white sm:pr-3 hidden">
				© 2020 Studio Dice/SHUEISHA, TV TOKYO, KONAMI
			</p>
			{{#if settings.show_copyright}}
			<p class="!text-sm text-white notranslate">
				<span class="copyright"></span>
				Coda. All rights reserved.
			</p>
			{{/if}}
		</div>
	</div>
</footer>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		// Show copyright for Master Duel category by checking breadcrumbs
		const breadcrumbsNav = document.querySelector('.custom-breadcrumbs');
		const breadcrumbLinks = breadcrumbsNav?.querySelectorAll('a');

		// Check if any breadcrumb link contains "Master Duel"
		if (breadcrumbLinks) {
			const isMasterDuel = breadcrumbLinks[1] && breadcrumbLinks[1].textContent === "Yu-Gi-Oh! MASTER DUEL";

			if (isMasterDuel) {
				document.getElementById('master-duel_copyright').classList.remove('hidden');
			}
		}
	});
</script>