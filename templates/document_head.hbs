<script>
	window.zendeskThemeSettings = {
		efootball: {
			logo: '{{settings.efootball_logo}}',
			bannerImage: '{{settings.efootball_banner_image}}',
			bannerMobile: '{{settings.efootball_banner_mobile}}',
			primary: '{{settings.efootball_primary_color}}',
			secondary: '{{settings.efootball_secondary_color}}'
		},
		blockman: {
			logo: '{{settings.blockman_logo}}',
			bannerImage: '{{settings.blockman_banner_image}}',
			bannerMobile: '{{settings.blockman_banner_mobile}}',
			primary: '{{settings.blockman_primary_color}}',
			secondary: '{{settings.blockman_secondary_color}}'
		},
		moba: {
			logo: '{{settings.moba_logo}}',
			bannerImage: '{{settings.moba_banner_image}}',
