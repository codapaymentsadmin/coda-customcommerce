<script>
	// Default languages for all pages
	let defaultLanguages = ["en", "pt", "id", "ms", "ko", "th", "tr", "es", "de", "fr", "cs", "da", "hu", "it", "nl", "pl", "sv", "ar", "km", "zh-TW"];

	// Check if we're on Yu-Gi-Oh! Master Duel category page and override languages
	if (window.location.pathname.includes('/categories/13839148070159-Yu-Gi-Oh-MASTER-DUEL')) {
		defaultLanguages = ["en", "ko", "zh-TW"];
	}

	if (window.location.pathname.includes('/categories/13560236615311-eBaseball-MLB-PRO-SPIRIT')) {
		defaultLanguages = ["en"];
	}

	window.gtranslateSettings = {
		"default_language": "en",
		"native_language_names": true,
		"detect_browser_language": true,
		"languages": defaultLanguages,
		"wrapper_selector": ".gtranslate_wrapper",
		"flag_style": "3d",
		"alt_flags": { "en": "usa" }
	};
</script>
