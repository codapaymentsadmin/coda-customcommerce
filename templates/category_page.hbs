<div class="gtranslate_wrapper"></div>
<!-- Hero Section -->
<section id="cc-hero-section" class="hero min-h-[30dvh] sm:min-h-[40dvh] bg-cover" data-hero-section>
	<div class="hero-overlay"></div>
	<div class="hero-content w-full max-w-3xl text-neutral-content text-center">
		<div class="w-full">
			<div id="category-logo" class="mb-4" style="display: none;">
				<img id="category-logo-img" src="" alt="{{category.name}} Logo" class="mx-auto max-h-20">
			</div>
			<h1 class="mb-5 text-banner-text font-bold notranslate">
				{{category.name}}
			</h1>
			{{#if category.description}}
			<p class="text-banner-text mb-6">{{category.description}}</p>
			{{/if}}
			{{search
			instant=true
			class="input max-md:w-full md:w-2/3 lg:w-full focus-within:outline-sky-500 !text-main-text rounded-lg h-12 py-1"
			}}
		</div>
	</div>
</section>

<section id="category-sections-articles" class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 py-12">
	<div class="flex flex-col items-center">
		<!-- Breadcrumbs using Zendesk helper -->
		<nav class="custom-breadcrumbs text-sm mb-6 w-full">
			{{breadcrumbs}}
		</nav>

		<h2 class="!text-3xl text-main-text font-bold">
			<span>{{category.name}}</span>
			Support
		</h2>
		<p class="text-center text-main-text mt-2">Browse through sections and articles for <span>{{category.name}}</span>
		</p>
		<ul class="w-full list mt-8 gap-4">
			{{#each sections}}
			<div class="collapse collapse-arrow bg-accordion-bg border border-gray-200 shadow-sm">
				<input type="checkbox" name="section-accordion-{{id}}" />
				<div class="collapse-title font-semibold">
					<h4 class="text-lg font-semibold text-accordion-text">
						{{name}}
					</h4>
					{{#if description}}
					<p class="text-accordion-text font-light">
						{{description}}
					</p>
					{{/if}}
				</div>
				<div id="articles-{{id}}" class="collapse-content text-sm gap-2">
					<div class="w-full flex flex-col gap-2">
						{{#each sections}}
						{{#if (compare @index "<" 3)}} <a href="{{url}}"
							class="btn btn-md h-[60px] flex items-center justify-between bg-cta text-cta-text hover:bg-cta/90 transition-colors rounded-lg text-start text-sm font-medium shadow-md subsection-btn">
							<div class="flex items-center gap-3">
								<i class="ph ph-folder text-lg"></i>
								<span>{{name}}</span>
							</div>
							<i class="ph ph-arrow-right"></i>
							</a>
							{{/if}}
							{{/each}}

							{{#each articles}}
							{{#if (compare @index "<" 5)}} <a href="{{url}}"
								class="btn btn-md h-[50px] flex items-center justify-between border-2 border-cta bg-white text-cta hover:bg-cta hover:text-white transition-colors rounded-lg text-start text-sm line-clamp-1 leading-4 shadow-sm article-btn">
								{{title}}
								<i class="ph ph-arrow-right"></i>
								</a>
								{{/if}}
								{{/each}}

								{{#unless sections}}{{#unless articles}}
								<p class="text-accordion-text text-sm italic">No content available in this section yet.</p>
								{{/unless}}{{/unless}}
					</div>

					{{#if (compare articles.length ">" 5)}}
					<div class="w-full flex justify-end mt-4">
						<a href="{{url}}"
							class="btn btn-sm bg-transparent border border-cta text-cta hover:bg-cta hover:text-cta-text transition-colors rounded-lg shadow-sm view-more-btn">
							View More
							<i class="ph ph-arrow-right text-xs"></i>
						</a>
					</div>
					{{/if}}
				</div>
			</div>
			{{/each}}
		</ul>

		{{#unless sections}}
		<div class="text-center py-8">
			<p class="text-main-text">No sections available in this category yet.</p>
		</div>
		{{/unless}}
	</div>
</section>

<section id="contact-support-section" class="max-w-5xl max-md:w-full md:w-2/3 lg:w-full mx-auto px-4 py-12">
	<div class="flex flex-col items-center">
		<div class="p-4 flex items-center justify-center rounded-full bg-brand support-icon-bg">
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#ffffff" viewBox="0 0 256 256">
				<path
					d="M144,180a16,16,0,1,1-16-16A16,16,0,0,1,144,180Zm92-52A108,108,0,1,1,128,20,108.12,108.12,0,0,1,236,128Zm-24,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128ZM128,64c-24.26,0-44,17.94-44,40v4a12,12,0,0,0,24,0v-4c0-8.82,9-16,20-16s20,7.18,20,16-9,16-20,16a12,12,0,0,0-12,12v8a12,12,0,0,0,23.73,2.56C158.31,137.88,172,122.37,172,104,172,81.94,152.26,64,128,64Z">
				</path>
			</svg>
		</div>
		<h3 class="text-lg font-semibold text-main-text !mt-4">Need Assistance?</h3>
		<p class="text-main-text text-center mt-2">Can't find what you're looking for? Our support team is here to help.</p>
		<a href="{{page_path 'new_request'}}"
			class="btn bg-cta/80 hover:bg-cta border-none shadow-none text-cta-text mt-4 contact-support-btn">
			Contact Support
		</a>
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		// Get the breadcrumbs to determine category
		const breadcrumbsNav = document.querySelector('.custom-breadcrumbs');
		const breadcrumbLinks = breadcrumbsNav?.querySelectorAll('a');
		let categoryName = null;

		// Get category name from the page title or breadcrumbs
		const categoryTitle = document.querySelector('h1')?.textContent?.trim();
		const pagePath = window.location.pathname.toLowerCase();

		// Category-specific theme colors and assets (map category names to manifest settings)
		const categoryThemes = {
			'eFootball™': {
				primary: '{{settings.efootball_primary_color}}',
				secondary: '{{settings.efootball_secondary_color}}',
				bannerImage: '{{settings.efootball_banner_image}}',
				logo: '{{settings.efootball_logo}}'
			},
			'eBaseball™: MLB PRO SPIRIT': {
				primary: '{{settings.ebaseball_primary_color}}',
				secondary: '{{settings.ebaseball_secondary_color}}',
				bannerImage: '{{settings.ebaseball_banner_image}}',
				logo: '{{settings.ebaseball_logo}}'
			}
			// Add more games here as needed
		};

		// Check if we're on eFootball category page
		if (categoryTitle?.includes('eFootball™') || pagePath.includes('efootball')) {
			const theme = categoryThemes['eFootball™'];

			// Set banner image with responsive handling
			const heroSection = document.querySelector('[data-hero-section]');
			if (heroSection && theme.bannerImage) {
				const isMobile = window.innerWidth <= 475;
				const bannerImage = isMobile ? '{{settings.efootball_banner_mobile}}' : theme.bannerImage;

				if (bannerImage) {
					heroSection.style.backgroundImage = `url(${bannerImage})`;
					heroSection.style.backgroundSize = 'cover';
					heroSection.style.backgroundPosition = 'center center';
					heroSection.style.backgroundRepeat = 'no-repeat';
					heroSection.style.backgroundColor = '#00009d';
				}
			}

			// Set logo
			const logoContainer = document.getElementById('category-logo');
			const logoImg = document.getElementById('category-logo-img');
			if (logoContainer && logoImg && theme.logo) {
				logoImg.src = theme.logo;
				logoContainer.style.display = 'block';
			}

			// Apply eFootball theming to subsection buttons
			const subsectionBtns = document.querySelectorAll('.subsection-btn');
			subsectionBtns.forEach(btn => {
				btn.classList.remove('bg-cta', 'hover:bg-cta/90');
				btn.classList.add('bg-efootball-primary', 'hover:bg-efootball-primary/90');
			});

			// Apply eFootball theming to article buttons
			const articleBtns = document.querySelectorAll('.article-btn');
			articleBtns.forEach(btn => {
				btn.classList.remove('border-cta', 'text-cta', 'hover:bg-cta');
				btn.classList.add('border-efootball-primary', 'text-efootball-primary', 'hover:bg-efootball-primary');
			});

			// Apply eFootball theming to view more buttons
			const viewMoreBtns = document.querySelectorAll('.view-more-btn');
			viewMoreBtns.forEach(btn => {
				btn.classList.remove('border-cta', 'text-cta', 'hover:bg-cta');
				btn.classList.add('border-efootball-primary', 'text-efootball-primary', 'hover:bg-efootball-primary');
			});

			// Apply eFootball theming to contact support button
			const contactBtns = document.querySelectorAll('.contact-support-btn');
			contactBtns.forEach(btn => {
				btn.classList.remove('bg-cta/80', 'hover:bg-cta');
				btn.classList.add('bg-efootball-primary', 'hover:bg-efootball-primary');
			});

			// Apply eFootball theming to support icon background
			const supportIconBg = document.querySelector('.support-icon-bg');
			if (supportIconBg) {
				supportIconBg.classList.remove('bg-brand');
				supportIconBg.classList.add('bg-efootball-primary');
			}

			breadcrumbLinks[0].textContent = 'KONAMI Web Store Support';
			// Style the category link in breadcrumbs
			breadcrumbLinks.forEach((breadcrumb, index) => {
				const categoryLink = breadcrumbLinks[index];
				if (categoryLink) {
					categoryLink.style.setProperty('--hover-color', theme.primary);
					categoryLink.classList.add('category-themed');
				}
			});

			// Style search button
			const searchButton = document.querySelector('input[name="commit"][value="Search"]');
			if (searchButton) {
				searchButton.style.setProperty('background-color', theme.primary);
				searchButton.classList.add('category-themed');
			}
		}

		// Check if we're on eBaseball category page
		if (categoryTitle?.includes('eBaseball™: MLB PRO SPIRIT') || pagePath.includes('ebaseball')) {
			const theme = categoryThemes['eBaseball™: MLB PRO SPIRIT'];

			// Set banner image with responsive handling
			const heroSection = document.querySelector('[data-hero-section]');
			if (heroSection && theme.bannerImage) {
				const isMobile = window.innerWidth <= 768;
				const bannerImage = isMobile ? '{{settings.ebaseball_banner_mobile}}' : theme.bannerImage;

				if (bannerImage) {
					heroSection.style.backgroundImage = `url(${bannerImage})`;
					heroSection.style.backgroundSize = 'cover';
					heroSection.style.backgroundPosition = 'center center';
					heroSection.style.backgroundRepeat = 'no-repeat';
					heroSection.style.backgroundColor = '#121b28';
				}
			}

			// Set logo
			const logoContainer = document.getElementById('category-logo');
			const logoImg = document.getElementById('category-logo-img');
			if (logoContainer && logoImg && theme.logo) {
				logoImg.src = theme.logo;
				logoContainer.style.display = 'block';
			}

			// Apply eBaseball theming to subsection buttons
			const subsectionBtns = document.querySelectorAll('.subsection-btn');
			subsectionBtns.forEach(btn => {
				btn.classList.remove('bg-cta', 'hover:bg-cta/90');
				btn.classList.add('bg-ebaseball-primary', 'hover:bg-ebaseball-primary/90');
			});

			// Apply eBaseball theming to article buttons
			const articleBtns = document.querySelectorAll('.article-btn');
			articleBtns.forEach(btn => {
				btn.classList.remove('border-cta', 'text-cta', 'hover:bg-cta');
				btn.classList.add('border-ebaseball-primary', 'text-ebaseball-primary', 'hover:bg-ebaseball-primary');
			});

			// Apply eBaseball theming to view more buttons
			const viewMoreBtns = document.querySelectorAll('.view-more-btn');
			viewMoreBtns.forEach(btn => {
				btn.classList.remove('border-cta', 'text-cta', 'hover:bg-cta');
				btn.classList.add('border-ebaseball-primary', 'text-ebaseball-primary', 'hover:bg-ebaseball-primary');
			});

			// Apply eBaseball theming to contact support button
			const contactBtns = document.querySelectorAll('.contact-support-btn');
			contactBtns.forEach(btn => {
				btn.classList.remove('bg-cta/80', 'hover:bg-cta');
				btn.classList.add('bg-ebaseball-primary', 'hover:bg-ebaseball-primary');
			});

			// Apply eBaseball theming to support icon background
			const supportIconBg = document.querySelector('.support-icon-bg');
			if (supportIconBg) {
				supportIconBg.classList.remove('bg-brand');
				supportIconBg.classList.add('bg-ebaseball-primary');
			}

			// Style the category link in breadcrumbs
			breadcrumbLinks.forEach((breadcrumb, index) => {
				const categoryLink = breadcrumbLinks[index];
				if (categoryLink) {
					categoryLink.style.setProperty('--hover-color', theme.primary);
					categoryLink.classList.add('category-themed');
				}
			});

			// Style search button
			const searchButton = document.querySelector('input[name="commit"][value="Search"]');
			if (searchButton) {
				searchButton.style.setProperty('background-color', theme.primary);
				searchButton.classList.add('category-themed');
			}
		}

		// Add 'notranslate' class to breadcrumb links containing game names
		const breadcrumbLinksElement = document.querySelectorAll('.custom-breadcrumbs ol.breadcrumbs li a');
		breadcrumbLinksElement[0].textContent = 'KONAMI Web Store Support';
		breadcrumbLinksElement.forEach(link => {
			const linkText = link.textContent.toLowerCase();
			if (linkText.includes('eFootball™') || linkText.includes('eBaseball™: MLB PRO SPIRIT') || linkText.includes('KONAMI Web Store Support')) {
				link.classList.add('notranslate');
			}
		});

		// Handle window resize for responsive banner images
		window.addEventListener('resize', function () {
			const heroSection = document.querySelector('[data-hero-section]');
			if (!heroSection) return;

			const isMobile = window.innerWidth <= 768;

			if (categoryTitle?.includes('eFootball™') || pagePath.includes('efootball')) {
				const theme = categoryThemes['eFootball™'];
				const bannerImage = isMobile ? '{{settings.efootball_banner_mobile}}' : theme.bannerImage;
				if (bannerImage) {
					heroSection.style.backgroundImage = `url(${bannerImage})`;
				}
			}

			if (categoryTitle?.includes('eBaseball™: MLB PRO SPIRIT') || pagePath.includes('ebaseball')) {
				const theme = categoryThemes['eBaseball™: MLB PRO SPIRIT'];
				const bannerImage = isMobile ? '{{settings.ebaseball_banner_mobile}}' : theme.bannerImage;
				if (bannerImage) {
					heroSection.style.backgroundImage = `url(${bannerImage})`;
				}
			}
		});
	});
</script>